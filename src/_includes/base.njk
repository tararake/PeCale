<!DOCTYPE html><html lang="ro"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title or "PeCale" }} | PeCale</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,400&family=Karla:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css"><style>.logo{display:flex;align-items:center;gap:.6rem}.logo img{height:54px;width:auto}main{max-width:980px}
.cards{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}.banner{width:100%;aspect-ratio:21/9;object-fit:cover;object-position:center 62%;border-radius:14px;box-shadow:0 22px 50px rgba(58,53,44,.16);margin:1rem 0 2.5rem;display:block}

.path{width:100%;height:50px;margin:1rem 0 2rem}.path path{fill:none;stroke:var(--terra);stroke-width:2;stroke-dasharray:2 9;stroke-linecap:round}
.card svg{width:42px;height:42px;margin-bottom:1rem;stroke:var(--sage);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.card{transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(58,53,44,.1)}
article h2{margin:2rem 0 .8rem;font-size:1.5rem}article img,.cover{max-width:100%;height:auto;border-radius:10px;display:block;margin:1.5rem 0}
@media(max-width:760px){.banner{aspect-ratio:4/3}}</style></head><body>
<header><a class="logo" href="/"><img src="/uploads/logo.png" alt="PeCale"></a><nav><a href="/scrieri/">Scrieri</a><a href="/audio/">Audio</a><a href="/biblioteca/">Bibliotecă</a><a href="/grupuri/">Grupuri</a></nav></header>
<main>{{ content | safe }}</main>
<footer>Cristian Tararache · Psiholog Psihoterapeut · Brașov<br><a href="https://cristiantararache.ro">Programări individuale: cristiantararache.ro</a></footer>
</body></html>
